CLAWHUB_BASE_URL=https://clawhub.ai
CLAWHUB_PUBLIC_API_BASE=https://clawhub.ai
CLAWHUB_PUBLIC_API_SKILLS_PATH=/api/v1/skills
CLAWHUB_USER_AGENT=ClawHubAnalyzer/0.1 (+academic research crawler; public pages only)
CLAWHUB_REQUESTS_PER_SECOND=0.5
CLAWHUB_CONCURRENT_REQUESTS=4
CLAWHUB_USE_PLAYWRIGHT=true
CLAWHUB_REQUEST_TIMEOUT=20
CLAWHUB_RETRIES=3
CLAWHUB_OUTPUT_DIR=data
CLAWHUB_DB_PATH=data/clawhub.sqlite3
CLAWHUB_SAVE_HTML=true
CLAWHUB_MAX_PAGES=100
CLAWHUB_ROBOTS_AWARE=true
CLAWHUB_DRY_RUN=false
CLAWHUB_SEARCH_TOP_K=20
CLAWHUB_SEARCH_QUERIES=slack,github,notion,calendar,pdf,search,memory,gmail,docs,agent,install,skill
CLAWHUB_PLAYWRIGHT_TIMEOUT_MS=15000
CLAWHUB_BROWSE_SCROLL_STEPS=8
CLAWHUB_SEARCH_SCROLL_STEPS=4
CLAWHUB_API_PAGE_SIZE=200
CLAWHUB_API_INDEX_SORT=downloads
