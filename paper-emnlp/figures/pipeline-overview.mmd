%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#EFF6FF', 'primaryBorderColor': '#2563EB', 'lineColor': '#4B5563', 'textColor': '#1F2937', 'fontSize': '14px', 'fontFamily': 'Arial, Helvetica, sans-serif'}, 'flowchart': {'htmlLabels': true, 'curve': 'basis', 'padding': 10, 'nodeSpacing': 18, 'rankSpacing': 28}}}%%

flowchart TD
    subgraph DATA["<b>§3  Data</b>"]
        clawhub["<b>ClawHub Snapshot</b><br/>18,441 skill listings"]
    end

    subgraph AUDIT["<b>§3  Auditor Pipeline</b>"]
        direction LR
        auditor["Qwen 2.5-7B<br/>T = 0.1 · A100"]
        axes["4 Axes: IC class<br/>Severity · Quality · Abuse"]
        auditor --> axes
    end

    subgraph ICOUT["IC Distribution"]
        direction LR
        ic0(["<b>IC-0</b> 95%"])
        ic1s(["<b>IC-1s</b> 3.5%"])
        ic1q(["<b>IC-1q</b> 1.1%"])
        ic2(["<b>IC-2</b> 0.4%"])
    end

    subgraph VALID["<b>§4  Validation</b>"]
        direction LR
        expert["Expert Labels<br/><i>n</i>=150 · κ=0.71"]
        impl["Impl. Grounded<br/><i>n</i>=150 · P=0.90"]
    end

    subgraph IMPACT["<b>§5–6  Downstream Impact</b>"]
        direction LR
        bm25["<b>BM25</b><br/>197 skills<br/>Δ+6.6pp"]
        routing["<b>Routing</b><br/>97 skills<br/>8,779 dec."]
        selection["<b>Selection</b><br/>8 clusters<br/>36 skills"]
    end

    subgraph FIND["<b>Key Findings</b>"]
        direction LR
        f1["10× gap<br/>vs. regex"]
        f2["+0.9pp<br/>aggregate"]
        f3["+8.1pp<br/>name-blind"]
    end

    DATA --> AUDIT
    AUDIT --> ICOUT
    AUDIT -->|"IC labels"| VALID
    VALID -->|"validated repairs"| IMPACT
    IMPACT --> FIND

